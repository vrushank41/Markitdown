# Optional: override the MarkItDown-compatible CLI command.
# When unset, the backend tries the Microsoft MarkItDown `markitdown` command
# first and falls back locally only if that command is not installed.
MARKITDOWN_COMMAND=

# Optional: extra args passed before the file path when MARKITDOWN_COMMAND is set.
MARKITDOWN_ARGS=

# Optional local development storage location.
# Production serverless deployments should replace the storage adapter with
# durable Blob/S3/R2 storage instead of local filesystem persistence.
MARKITDOWN_DATA_DIR=.data/markitdown
